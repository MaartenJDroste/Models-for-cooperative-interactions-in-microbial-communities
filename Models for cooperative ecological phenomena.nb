Cell[CellGroupData[{

Cell["Obligate syntrophy", "Subsection",
 CellChangeTimes->{{3.981509896222913*^9, 3.981509906197336*^9}, {
  3.981513647557312*^9, 3.981513654219182*^9}, {3.981514993976906*^9, 
  3.981515015408984*^9}, {3.9893090044901*^9, 3.9893090152418833`*^9}, {
  4.000779066343351*^9, 
  4.0007790690161457`*^9}},ExpressionUUID->"bfaf114f-7c21-4e1d-876e-\
404a7d9b68a0"],

Cell[TextData[StyleBox["To model obligate syntrophy, we use the exact same \
model as for mutualism, except we simulate it at lower values of the affinity \
of the consumer. This approximates the scenario close to thermodynamic \
equilibrium. This is explained in more detail in the Supplementary \
Appendices.",
 FontColor->GrayLevel[0]]], "Text",
 CellChangeTimes->{{3.968735521814046*^9, 3.9687355452811127`*^9}, 
   3.970639632935924*^9, {3.971263301102886*^9, 3.971263318973714*^9}, {
   3.9712644858993883`*^9, 3.9712649973215027`*^9}, {3.971265033853116*^9, 
   3.971265196761095*^9}, {3.971270716618887*^9, 3.971270724194241*^9}, {
   3.971270785501462*^9, 3.971270820171898*^9}, {3.971271222714066*^9, 
   3.971271242647586*^9}, {3.971271350853735*^9, 3.9712713595340023`*^9}, {
   3.9712714145715227`*^9, 3.971271673864236*^9}, {3.97127171809194*^9, 
