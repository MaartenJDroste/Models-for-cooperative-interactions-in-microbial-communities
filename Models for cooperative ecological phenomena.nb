Cell[TextData[{
 "We run the optimisation problem for different values of the biomass yield \
of the consumer. After obtaining the results, we normalise the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e1cc4c34-74c6-4e30-bb26-af0714fa88e1"],
 " concentration and the growth rate relative to the point with the lowest \
yield. This point is picked randomly and indicates the state of the \
population with only the producer."
}], "Text",
 CellChangeTimes->{{3.966609191933302*^9, 3.966609192394507*^9}, {
  3.9666092511073713`*^9, 3.9666092992736187`*^9}, {3.96660971203544*^9, 
