eb8d19f2b943"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ModelEquationsJoinedMut", "[", "Kminv_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       FractionBox["vRA", "eTotA"], "]"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Positivity", " ", "constraints"}], "*)"}], 
      RowBox[{
       RowBox[{"sA", ">=", "0"}], ",", 
       RowBox[{"p1", ">=", "0"}], ",", 
       RowBox[{"xB", ">=", "0"}], ",", 
       RowBox[{"e1A", ">=", "0"}], ",", 
       RowBox[{"eRA", ">=", "0"}], ",", 
       RowBox[{"euB", ">=", "0"}], ",", 
       RowBox[{"e1B", ">=", "0"}], ",", 
       RowBox[{"eRB", ">=", "0"}], ",", 
       RowBox[{"BB0", ">=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Enzyme", " ", "constraints"}], "*)"}], 
       RowBox[{
        RowBox[{"eTA", "+", "e1A", "+", "eRA"}], "<=", "eTotA"}], ",", 
       RowBox[{
        RowBox[{"euB", "+", "e1B", "+", "eRB"}], "<=", "eTotB"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Steady", " ", "states"}], "*)"}], 
       RowBox[{"vTA", "==", 
        RowBox[{"v1AKm", "+", 
         RowBox[{"YsARA", " ", "vRA"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRA", " ", "vRA"}], "==", " ", 
        RowBox[{"m1A", " ", "v1AKm"}]}], ",", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", "v1AKm"}], "==", 
        RowBox[{"BB0", " ", "vuBKm"}]}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "vuBKm"}], "==", 
        RowBox[{"v1B", "+", 
         RowBox[{"YxBRB", " ", "vRB"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRB", " ", "vRB"}], "==", 
        RowBox[{"m1B", " ", "v1B"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Biomass", " ", "relation"}], "*)"}], 
       RowBox[{
        RowBox[{"BA0", " ", "YxBp1", " ", "Yp1sA", " ", 
         FractionBox["mRA", "m1A"]}], " ", "==", 
        RowBox[{"BB0", 
         FractionBox["eTotB", "eTotA"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["mRB", "m1B"], "+", "YxBRB"}], ")"}]}]}]}], "}"}]}], 
    "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"Km", "->", "Kminv"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemFuncMut", "[", 
   RowBox[{"Kminv_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ModelEquationsJoinedMut", "[", "Kminv", "]"}], "/.", 
     "ParamsMut"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "sA", ",", "p1", ",", "xB", ",", "e1A", ",", "eRA", ",", "eRB", ",", 
      "euB", ",", "e1B", ",", "BB0"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.980852098687541*^9, 3.980852104563068*^9}, {
