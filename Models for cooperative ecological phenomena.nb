Cell[CellGroupData[{

Cell["\<\
Optimisation problem: Maximise the growth rate of the producer for varying \
affinity of the consumer B and fixed species C\
\>", "Subsubsection",
 CellChangeTimes->{{3.929695144133555*^9, 3.929695157197448*^9}, {
  3.929695260757389*^9, 3.929695261214814*^9}, {4.000551141546482*^9, 
  4.000551142228889*^9}, {4.0005511743415937`*^9, 4.000551200299768*^9}, {
  4.000551287616398*^9, 4.0005513021060877`*^9}, {4.000788310395761*^9, 
  4.000788314117496*^9}, {4.001760579945223*^9, 
  4.001760582204816*^9}},ExpressionUUID->"fe87a72a-1b7e-4e39-975b-\
2497be246475"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ModelEquationsJoinedSyn2Cons", "[", "Kminv_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       FractionBox["vRA", "eTotA"], "]"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Positivity", " ", "constraints"}], "*)"}], 
      RowBox[{
       RowBox[{"sA", ">=", "0"}], ",", 
       RowBox[{"p1", ">=", "0"}], ",", 
       RowBox[{"xB", ">=", "0"}], ",", 
       RowBox[{"p2", ">=", "0"}], ",", 
       RowBox[{"xC", ">=", "0"}], ",", 
       RowBox[{"e2A", ">=", "0"}], ",", 
       RowBox[{"e1A", ">=", "0"}], ",", 
       RowBox[{"eRA", ">=", "0"}], ",", 
       RowBox[{"euB", ">=", "0"}], ",", 
       RowBox[{"e1B", ">=", "0"}], ",", 
       RowBox[{"eRB", ">=", "0"}], ",", 
       RowBox[{"BB0", ">=", "0"}], ",", 
       RowBox[{"euC", ">=", "0"}], ",", 
       RowBox[{"e2C", ">=", "0"}], ",", 
       RowBox[{"eRC", ">=", "0"}], ",", 
       RowBox[{"BC0", ">=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Enzyme", " ", "constraints"}], "*)"}], 
       RowBox[{
        RowBox[{"eTA", "+", "e2A", "+", "e1A", "+", "eRA"}], "<=", "eTotA"}], 
       ",", 
       RowBox[{
        RowBox[{"euB", "+", "e1B", "+", "eRB"}], "<=", "eTotB"}], ",", 
       RowBox[{
        RowBox[{"euC", "+", "e2C", "+", "eRC"}], "<=", "eTotC"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Steady", " ", "states"}], "*)"}], 
       RowBox[{"vTA", "==", 
        RowBox[{"v2A", "+", "v1AKm", "+", 
         RowBox[{"YsARA", " ", "vRA"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRA", " ", "vRA"}], "==", " ", 
        RowBox[{
         RowBox[{"m2A", " ", "v2A"}], "+", 
         RowBox[{"m1A", " ", "v1AKm"}]}]}], ",", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", "v1AKm"}], "==", 
        RowBox[{"BB0", " ", "vuBKm"}]}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "vuBKm"}], "==", 
        RowBox[{"v1B", "+", 
         RowBox[{"YxBRB", " ", "vRB"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRB", " ", "vRB"}], "==", 
        RowBox[{"m1B", " ", "v1B"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp2sA", " ", "v2A"}], "==", 
        RowBox[{"BC0", " ", "vuC"}]}], ",", 
       RowBox[{
        RowBox[{"YxCp2", " ", "vuC"}], "==", 
        RowBox[{"v2C", "+", 
         RowBox[{"YxCRC", " ", "vRC"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRC", " ", "vRC"}], "==", 
        RowBox[{"m2C", " ", "v2C"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Biomass", " ", "relations"}], "*)"}], 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", 
         FractionBox["v1AKm", "vRA"]}], " ", "==", 
        RowBox[{
         FractionBox["BB0", "YxBp1"], " ", 
         FractionBox["eTotB", "eTotA"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["mRB", "m1B"], "+", "YxBRB"}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp2sA", " ", 
         FractionBox["v2A", "vRA"]}], " ", "==", 
        RowBox[{
         FractionBox["BC0", "YxCp2"], " ", 
         FractionBox["eTotC", "eTotA"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["mRC", "m2C"], "+", "YxCRC"}], ")"}]}]}]}], "}"}]}], 
    "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"Km", "->", "Kminv"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemFuncSyn2Cons", "[", 
   RowBox[{"Kminv_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ModelEquationsJoinedSyn2Cons", "[", "Kminv", "]"}], "/.", 
     "ParamsSyn2Cons"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "sA", ",", "p1", ",", "xB", ",", "p2", ",", "xC", ",", "e1A", ",", "e2A",
       ",", "eRA", ",", "eRB", ",", "euB", ",", "e1B", ",", "euC", ",", "e2C",
       ",", "eRC", ",", "BB0", ",", "BC0"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.001752599374629*^9, 4.0017526057639*^9}, {
  4.001753171306767*^9, 4.001753174257457*^9}, {4.001753249395205*^9, 
