Cell[BoxData[{
 RowBox[{
  RowBox[{"OptimisationProblemSolFacSyn", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Kminv", "->", "Kminvval"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"p1v", "->", "p1"}], ",", 
             RowBox[{"\[Lambda]A", "->", 
              FractionBox["vRA", "eTotA"]}], ",", 
             RowBox[{"\[Lambda]B", "->", 
              FractionBox["vRB", "eTotB"]}], ",", 
             RowBox[{"BiomB", "->", "BB0"}], ",", 
             RowBox[{"e1", "->", "e1A"}], ",", 
