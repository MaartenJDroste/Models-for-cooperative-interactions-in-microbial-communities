Cell[BoxData[{
 RowBox[{
  RowBox[{"ModelEquationsJoineddolvarS", "[", "sv_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       FractionBox["vRA", "eTotA"], "]"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Positivity", " ", "constraints"}], "*)"}], 
      RowBox[{
       RowBox[{"sA", ">=", "0"}], ",", 
       RowBox[{"p1", ">=", "0"}], ",", 
       RowBox[{"xB", ">=", "0"}], ",", 
       RowBox[{"e1A", ">=", "0"}], ",", 
       RowBox[{"e1Adol", ">=", "0"}], ",", 
       RowBox[{"e2A", ">=", "0"}], ",", 
       RowBox[{"e3A", ">=", "0"}], ",", 
       RowBox[{"eRA", ">=", "0"}], ",", 
       RowBox[{"euB", ">=", "0"}], ",", 
       RowBox[{"e1B", ">=", "0"}], ",", 
       RowBox[{"eRB", ">=", "0"}], ",", 
       RowBox[{"BB0", ">=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Enzyme", " ", "constraints"}], "*)"}], 
       RowBox[{
        RowBox[{
        "eTA", "+", "e1A", "+", "e1Adol", "+", "e2A", "+", "e3A", "+", 
         "eRA"}], "<=", "eTotA"}], ",", 
       RowBox[{
        RowBox[{"euB", "+", "e1B", "+", "eRB"}], "<=", "eTotB"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Steady", " ", "states"}], "*)"}], 
       RowBox[{"vTA", "==", 
        RowBox[{"v1A", "+", "v1Adol", "+", 
         RowBox[{"YsARA", " ", "vRA"}]}]}], ",", 
       RowBox[{
        RowBox[{"Yp1sA", " ", "v1Adol"}], "==", "v2Adol"}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "v2Adol"}], "==", "v3Adol"}], ",", 
       RowBox[{
        RowBox[{"mRA", " ", "vRA"}], "==", " ", 
        RowBox[{
         RowBox[{"m1A", " ", "v1A"}], "+", 
         RowBox[{"m1A", " ", "v1Adol"}], "+", " ", 
         RowBox[{"m3A", " ", "v3Adol"}]}]}], ",", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", "v1A"}], "==", 
        RowBox[{"BB0", " ", "vuB"}]}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "vuB"}], "==", 
        RowBox[{"v1Bdol", "+", 
         RowBox[{"YxBRB", " ", "vRB"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRB", " ", "vRB"}], "==", 
        RowBox[{"m1B", " ", "v1Bdol"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Biomass", " ", "relation"}], "*)"}], 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", 
         FractionBox["v1A", "vRA"]}], " ", "==", 
        RowBox[{
         FractionBox["BB0", "YxBp1"], 
         FractionBox["eTotB", "eTotA"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["mRB", "m1B"], "+", "YxBRB"}], ")"}]}]}]}], "}"}]}], 
    "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"s", "->", "sv"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemFuncdolvarS", "[", 
   RowBox[{"sv_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ModelEquationsJoineddolvarS", "[", "sv", "]"}], "/.", 
     "ParamsdolvarS"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "sA", ",", "p1", ",", "xB", ",", "e1A", ",", "e1Adol", ",", "e2A", ",", 
      "e3A", ",", "eRA", ",", "eRB", ",", "euB", ",", "e1B", ",", "BB0"}], 
     "}"}]}], "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.971259726045789*^9, 3.9712597363488407`*^9}, {
