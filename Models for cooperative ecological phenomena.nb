 RowBox[{
  RowBox[{"sstartOptdol", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sendOptdol", "=", "1.8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sstepOptdol", "=", "0.03"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemSoldolvarS", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s", "->", "sval"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Lambda]A", "->", 
              FractionBox["vRA", "eTotA"]}], ",", 
             RowBox[{"\[Lambda]B", "->", 
              FractionBox["vRB", "eTotB"]}], ",", 
             RowBox[{"BiomB", "->", "BB0"}], ",", 
             RowBox[{"e1", "->", "e1A"}], ",", 
             RowBox[{"e2", "->", 
              RowBox[{"e1Adol", "+", "e2A", "+", "e3A"}]}], ",", 
