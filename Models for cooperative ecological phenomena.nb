Cell[CellGroupData[{

Cell["Model and results for mutualism and obligate syntrophy ", "Section",
 CellChangeTimes->{
  3.981513625717708*^9, {4.000628780363429*^9, 
   4.0006288077466497`*^9}},ExpressionUUID->"be3f8031-057c-48e7-85bc-\
03492d82a4c4"],

Cell[TextData[{
 "To model mutualistic interactions, the cross-feeding of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],ExpressionUUID->
  "cce7cb79-aefd-4b02-bb46-d0d379143d38"],
 " should be beneficial to both the producer and the consumer. To make this \
effect apparent in both species, we set the equilibrium constant to Keq=10 \
for all reactions except the transport of S, and we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["K", "p1"], "A"], " ", "=", " ", 
    RowBox[{"0.01", " ", 
     RowBox[{"mM", "."}]}]}], TraditionalForm]],ExpressionUUID->
  "c0f53920-e867-4d3f-b583-0e016cbc2f3c"],
 "\n\nWe study the community as function of the affinity of the producer for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],ExpressionUUID->
  "df602878-155d-475e-8fad-4ee18f12c828"],
 ", which is described by the inverse of the parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["K", "p1"], "B"], TraditionalForm]],ExpressionUUID->
  "9ca3fabf-5650-4bba-a97e-96bd570daf7b"],
 " in our model (a lower Michaelis constant implies a higher affinity). \
Therefore, we write this as 1/",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", "m"], "  "}], TraditionalForm]],ExpressionUUID->
  "902b8da5-eadd-49a5-a51b-5ee9029da862"],
 "in the model, such that an increase in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "m"], TraditionalForm]],ExpressionUUID->
  "c78d001c-60e0-4508-842a-3a5e17fd9164"],
 " describes an increasing affinity.\n\nThese two adjustments require two \
adjusted rate equations for the fluxes v1A and vUB, which are given below. \
These are also used in all other simulations as function of the affinity of \
the producer."
}], "Text",
 CellChangeTimes->{{4.000779563414447*^9, 4.000779871928747*^9}, {
  4.0007820451851892`*^9, 4.000782105113002*^9}, {4.0007821439366493`*^9, 
  4.000782249452058*^9}, {4.00078237958327*^9, 
  4.000782392896606*^9}},ExpressionUUID->"67f44581-854d-4d31-afa1-\
0f715055605d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"v1AKm", "=", 
   RowBox[{"v", "[", 
    RowBox[{
    "k1A", ",", "sA", ",", "p1", ",", "e1A", ",", "2", ",", "0.01", ",", 
     "Keq"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vuBKm", "=", 
   RowBox[{"v", "[", 
    RowBox[{"kuB", ",", "p1", ",", "xB", ",", "euB", ",", 
     RowBox[{"1", "/", "Km"}], ",", "1", ",", "Keq"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[213]:=",ExpressionUUID->"b2d0771f-bca1-4372-ba75-ff11620b4640"],

Cell[CellGroupData[{

Cell["Mutualism", "Subsection",
 CellChangeTimes->{{3.981509896222913*^9, 3.981509906197336*^9}, {
  3.981513647557312*^9, 3.981513654219182*^9}, {3.981514993976906*^9, 
  3.981515015408984*^9}, {4.000779075652278*^9, 
  4.00077907950352*^9}},ExpressionUUID->"8e7a3565-3fb3-4c58-add1-\
25a621b12bc0"],

Cell[CellGroupData[{

Cell["Model parameters", "Subsubsection",
 CellChangeTimes->{{3.929695144133555*^9, 3.929695157197448*^9}, {
   3.929695260757389*^9, 3.929695261214814*^9}, {4.000551141546482*^9, 
   4.000551142228889*^9}, {4.0005511743415937`*^9, 4.0005511791628428`*^9}, {
   4.0005512210895643`*^9, 4.000551221588002*^9}, 
   4.000629746054007*^9},ExpressionUUID->"12c2dbfa-e246-4886-922d-\
c7b5ac75517f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ParamsMut", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", "0.3"}], ",", 
     RowBox[{"p2", "->", "0.1"}], ",", 
     RowBox[{"pB", "->", "0.02"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Keq", "->", "10"}], ",", 
     RowBox[{"KeqT", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"m2A", "->", "2"}], ",", 
     RowBox[{"m1A", "->", "1"}], ",", 
     RowBox[{"mRA", "->", "700"}], ",", "\[IndentingNewLine]", 
     RowBox[{"m1B", "->", "1"}], ",", 
     RowBox[{"mRB", "->", "700"}], ",", "\[IndentingNewLine]", 
     RowBox[{"YsARA", "->", "200"}], ",", 
     RowBox[{"Yp1sA", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"YxBp1", "->", "1"}], ",", 
     RowBox[{"YxBRB", "->", "200"}], ",", "\[IndentingNewLine]", 
     RowBox[{"eTotA", "->", "1"}], ",", 
     RowBox[{"eTA", "->", "0.1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"eTotB", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"kTA", "->", "1000"}], ",", 
     RowBox[{"k2A", "->", "185"}], ",", 
     RowBox[{"k1A", "->", "1000"}], ",", 
     RowBox[{"kRA", "->", "0.089"}], ",", 
     RowBox[{"fRA", "->", "0.8"}], ",", "\[IndentingNewLine]", 
     RowBox[{"kuB", "->", "1000"}], ",", 
     RowBox[{"k1B", "->", "500"}], ",", 
     RowBox[{"kRB", "->", "0.089"}], ",", 
