Cell[CellGroupData[{

Cell["\<\
Model and results for syntrophic interactions with multiple consumers\
\>", "Section",
 CellChangeTimes->{
  3.981513625717708*^9, {4.000628780363429*^9, 4.0006288077466497`*^9}, {
   4.0006288662408857`*^9, 
   4.0006288736111317`*^9}},ExpressionUUID->"64b74af5-d30e-4085-813e-\
8525f3c5469a"],

Cell[TextData[{
 "To model syntrophy with two consumers ",
 StyleBox["B, C, ",
  FontSlant->"Italic"],
 "we need to implement an additional consuming species. We extend the \
optimisation problem below to include this species. Its rate equations and \
parameters are defined below. They are similar to those of species ",
 StyleBox["B",
  FontSlant->"Italic"],
 ", such that both communities attain similar growth rates.\n\nSince all \
parameters of species ",
 StyleBox["C",
  FontSlant->"Italic"],
 " are fixed, the community consisting of species ",
 StyleBox["A",
  FontSlant->"Italic"],
 " and ",
 StyleBox["C",
  FontSlant->"Italic"],
 " has a constant (optimal) growth rate, as can be seen in the plots below. \
For sufficiently high affinity of species ",
 StyleBox["B",
  FontSlant->"Italic"],
 " for P1, this growth rate is exceeded, and the optimal strategy and \
community composition switch."
}], "Text",
 CellChangeTimes->{{4.000788142228346*^9, 4.000788270005577*^9}, {
   4.001751093726253*^9, 4.001751108101804*^9}, {4.0017511386281633`*^9, 
   4.001751163881592*^9}, {4.001751201546278*^9, 4.001751205249744*^9}, {
   4.001751243017288*^9, 4.001751256488557*^9}, {4.0017513056328983`*^9, 
   4.0017513598477297`*^9}, {4.0017528260787563`*^9, 4.001752864309073*^9}, {
   4.001758577147554*^9, 4.001758591254283*^9}, 4.0017586256578693`*^9, {
   4.0017590166254673`*^9, 4.001759193009914*^9}, {4.001759244361395*^9, 
   4.0017593006532784`*^9}},ExpressionUUID->"bf54e151-de1c-43da-8024-\
ebfe6f36e8c5"],

Cell[CellGroupData[{

