Cell[CellGroupData[{

Cell[TextData[{
 "Division of labour as function of affinity of the consumer for its carbon \
substrate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3271513a-3e2a-4ecf-a8e4-31a3a1ab2c25"]
}], "Subsection",
 CellChangeTimes->{{3.990519125053755*^9, 3.99051915914713*^9}, {
  3.990519286933717*^9, 3.990519297527424*^9}, {3.990522658835676*^9, 
  3.990522659012265*^9}, {4.000629008046398*^9, 
  4.000629034582456*^9}},ExpressionUUID->"b0002dfe-a00b-4eb4-bfe8-\
a9e8d8b8f5f3"],

Cell["\<\
Here we simulate the division of labour model as function of the affinity of \
the consumer. Again, this requires a new definition for some rate equations \
and corresponding parameters. Qualitatively, this results in the same plots \
as for facultative syntrophy.\
\>", "Text",
 CellChangeTimes->{{4.0007908325035543`*^9, 4.000790870552012*^9}, {
  4.0007912377512283`*^9, 
  4.000791254880115*^9}},ExpressionUUID->"a0998a22-2efa-40db-bfcf-\
7877f7d5c88d"],

Cell[CellGroupData[{

Cell["Rate equations and model parameters", "Subsubsection",
 CellChangeTimes->{{3.929695144133555*^9, 3.929695157197448*^9}, {
   3.929695260757389*^9, 3.929695261214814*^9}, {4.000551141546482*^9, 
   4.000551142228889*^9}, {4.0005511743415937`*^9, 4.0005511791628428`*^9}, {
   4.0005512210895643`*^9, 4.000551221588002*^9}, 4.000629746054007*^9, {
   4.000790498334813*^9, 
   4.000790501024221*^9}},ExpressionUUID->"d259ad14-c2c4-4b49-af9a-\
8f8aa6b02a6b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"v1AdolKm", "=", 
    RowBox[{"v", "[", 
     RowBox[{
     "k1A", ",", "sA", ",", "p1", ",", "e1Adol", ",", "2", ",", "0.01", ",", 
      "Keq"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParamsdolvarKm", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", "0.8"}], ",", 
     RowBox[{"p2", "->", "0.01"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Keq", "->", "10"}], ",", 
     RowBox[{"KeqT", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"m1A", "->", "1"}], ",", 
     RowBox[{"m3A", "->", "1"}], ",", 
     RowBox[{"mRA", "->", "700"}], ",", "\[IndentingNewLine]", 
     RowBox[{"m1B", "->", "1"}], ",", 
     RowBox[{"mRB", "->", "700"}], ",", "\[IndentingNewLine]", 
     RowBox[{"YsARA", "->", "200"}], ",", 
     RowBox[{"Yp1sA", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"YxBp1", "->", "1"}], ",", 
     RowBox[{"YxBRB", "->", "200"}], ",", "\[IndentingNewLine]", 
     RowBox[{"eTotA", "->", "1"}], ",", 
     RowBox[{"eTA", "->", "0.1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"eTotB", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"kTA", "->", "1000"}], ",", 
     RowBox[{"k1A", "->", "1000"}], ",", 
     RowBox[{"k2A", "->", "300"}], ",", 
     RowBox[{"k3A", "->", "300"}], ",", 
     RowBox[{"kRA", "->", "0.089"}], ",", 
     RowBox[{"fRA", "->", "0.8"}], ",", "\[IndentingNewLine]", 
     RowBox[{"kuB", "->", "1000"}], ",", 
     RowBox[{"k1B", "->", "500"}], ",", 
     RowBox[{"kRB", "->", "0.089"}], ",", 
     RowBox[{"fRB", "->", "0.8"}], ",", "\[IndentingNewLine]", 
     RowBox[{"BA0", "->", "1"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.990521942154853*^9, 3.99052196887282*^9}, {
  3.990522022980486*^9, 3.990522052513019*^9}, {3.990522088389773*^9, 
  3.990522090001001*^9}, {4.000791021577183*^9, 4.0007910247602377`*^9}, {
  4.000791084174732*^9, 4.0007910869850607`*^9}},
 CellLabel->
  "In[288]:=",ExpressionUUID->"71586c0f-7fbf-4df9-b56c-d51945f293c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Optimisation problem: Maximise the growth rate of the producer for varying \
affinity of the consumer\
\>", "Subsubsection",
 CellChangeTimes->{{3.929695144133555*^9, 3.929695157197448*^9}, {
  3.929695260757389*^9, 3.929695261214814*^9}, {4.000551141546482*^9, 
  4.000551142228889*^9}, {4.0005511743415937`*^9, 4.000551200299768*^9}, {
  4.000551287616398*^9, 4.0005513021060877`*^9}, {4.000629770509654*^9, 
  4.0006297711816673`*^9}, {4.0007827843761883`*^9, 4.000782787676731*^9}, {
  4.0007838742468653`*^9, 
  4.000783875020034*^9}},ExpressionUUID->"aae40dc5-6019-40f0-aa16-\
7b3005b8f254"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ModelEquationsJoineddolvarKm", "[", "Kminv_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       FractionBox["vRA", "eTotA"], "]"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Positivity", " ", "constraints"}], "*)"}], 
      RowBox[{
       RowBox[{"sA", ">=", "0"}], ",", 
       RowBox[{"p1", ">=", "0"}], ",", 
       RowBox[{"xB", ">=", "0"}], ",", 
       RowBox[{"e1A", ">=", "0"}], ",", 
       RowBox[{"e1Adol", ">=", "0"}], ",", 
       RowBox[{"e2A", ">=", "0"}], ",", 
       RowBox[{"e3A", ">=", "0"}], ",", 
       RowBox[{"eRA", ">=", "0"}], ",", 
       RowBox[{"euB", ">=", "0"}], ",", 
       RowBox[{"e1B", ">=", "0"}], ",", 
       RowBox[{"eRB", ">=", "0"}], ",", 
       RowBox[{"BB0", ">=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Enzyme", " ", "constraints"}], "*)"}], 
       RowBox[{
        RowBox[{
        "eTA", "+", "e1A", "+", "e1Adol", "+", "e2A", "+", "e3A", "+", 
         "eRA"}], "<=", "eTotA"}], ",", 
       RowBox[{
        RowBox[{"euB", "+", "e1B", "+", "eRB"}], "<=", "eTotB"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Steady", " ", "states"}], "*)"}], 
       RowBox[{"vTA", "==", 
        RowBox[{"v1AKm", "+", "v1AdolKm", "+", 
         RowBox[{"YsARA", " ", "vRA"}]}]}], ",", 
       RowBox[{
        RowBox[{"Yp1sA", " ", "v1AdolKm"}], "==", "v2Adol"}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "v2Adol"}], "==", "v3Adol"}], ",", 
       RowBox[{
        RowBox[{"mRA", " ", "vRA"}], "==", " ", 
        RowBox[{
         RowBox[{"m1A", " ", "v1AKm"}], "+", 
         RowBox[{"m1A", " ", "v1AdolKm"}], "+", " ", 
         RowBox[{"m3A", " ", "v3Adol"}]}]}], ",", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", "v1AKm"}], "==", 
        RowBox[{"BB0", " ", "vuBKm"}]}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "vuBKm"}], "==", 
        RowBox[{"v1Bdol", "+", 
         RowBox[{"YxBRB", " ", "vRB"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRB", " ", "vRB"}], "==", 
        RowBox[{"m1B", " ", "v1Bdol"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Biomass", " ", "relation"}], "*)"}], 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", 
         FractionBox["v1AKm", "vRA"]}], " ", "==", 
        RowBox[{
         FractionBox["BB0", "YxBp1"], 
         FractionBox["eTotB", "eTotA"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["mRB", "m1B"], "+", "YxBRB"}], ")"}]}]}]}], "}"}]}], 
    "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"Km", "->", "Kminv"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemFuncdolvarKm", "[", 
   RowBox[{"Kminv_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ModelEquationsJoineddolvarKm", "[", "Kminv", "]"}], "/.", 
     "ParamsdolvarKm"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "sA", ",", "p1", ",", "xB", ",", "e1A", ",", "e1Adol", ",", "e2A", ",", 
