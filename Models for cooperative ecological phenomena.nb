Cell[CellGroupData[{

Cell["\<\
Optimisation problem: Maximise the growth rate of the producer for varying \
concentrations of S\
\>", "Subsubsection",
 CellChangeTimes->{{3.929695144133555*^9, 3.929695157197448*^9}, {
  3.929695260757389*^9, 3.929695261214814*^9}, {4.000551141546482*^9, 
  4.000551142228889*^9}, {4.0005511743415937`*^9, 4.000551200299768*^9}, {
  4.000551287616398*^9, 4.0005513021060877`*^9}, {4.000629770509654*^9, 
  4.0006297711816673`*^9}},ExpressionUUID->"8ca06721-316d-4148-9518-\
33d3382dcf2f"],

Cell["\<\
Note that the biomass relation describing the coupling of the biomass of both \
species is written in a slightly different form and does not contain the \
densities \[Rho] of both species. We have neglected these since they are \
assumed to be constant, so these can be scaled out of this relation. We are \
only interested in qualitative changes in the relative biomass fractions, \
that are not affected by these constant densities. We use this notation in \
all optimisation problems in this notebook.\
\>", "Text",
 CellChangeTimes->{{4.000630255231879*^9, 4.000630386081682*^9}, {
  4.0007827584117537`*^9, 
  4.000782771025105*^9}},ExpressionUUID->"4ed7765c-c425-453e-b92b-\
35d9ef2acf72"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ModelEquationsJoinedvarS", "[", "sv_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       FractionBox["vRA", "eTotA"], "]"}], "}"}], ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Positivity", " ", "constraints"}], "*)"}], 
      RowBox[{
       RowBox[{"sA", ">=", "0"}], ",", 
       RowBox[{"p1", ">=", "0"}], ",", 
       RowBox[{"xB", ">=", "0"}], ",", 
       RowBox[{"e2A", ">=", "0"}], ",", 
       RowBox[{"e1A", ">=", "0"}], ",", 
       RowBox[{"eRA", ">=", "0"}], ",", 
       RowBox[{"euB", ">=", "0"}], ",", 
       RowBox[{"e1B", ">=", "0"}], ",", 
       RowBox[{"eRB", ">=", "0"}], ",", 
       RowBox[{"BB0", ">=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Enzyme", " ", "constraints"}], "*)"}], 
       RowBox[{
        RowBox[{"eTA", "+", "e2A", "+", "e1A", "+", "eRA"}], "<=", "eTotA"}], 
       ",", 
       RowBox[{
        RowBox[{"euB", "+", "e1B", "+", "eRB"}], "<=", "eTotB"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Steady", " ", "states"}], "*)"}], 
       RowBox[{"vTA", "==", 
        RowBox[{"v2A", "+", "v1A", "+", 
         RowBox[{"YsARA", " ", "vRA"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRA", " ", "vRA"}], "==", " ", 
        RowBox[{
         RowBox[{"m2A", " ", "v2A"}], "+", 
         RowBox[{"m1A", " ", "v1A"}]}]}], ",", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", "v1A"}], "==", 
        RowBox[{"BB0", " ", "vuB"}]}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "vuB"}], "==", 
        RowBox[{"v1B", "+", 
         RowBox[{"YxBRB", " ", "vRB"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRB", " ", "vRB"}], "==", 
        RowBox[{"m1B", " ", "v1B"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Biomass", " ", "relation"}], "*)"}], 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", 
         FractionBox["v1A", "vRA"]}], " ", "==", 
        RowBox[{
         FractionBox["BB0", "YxBp1"], 
         FractionBox["eTotB", "eTotA"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["mRB", "m1B"], "+", "YxBRB"}], ")"}]}]}]}], "}"}]}], 
    "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"s", "->", "sv"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemFuncvarS", "[", 
   RowBox[{"sv_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ModelEquationsJoinedvarS", "[", "sv", "]"}], "/.", 
     "ParamsvarS"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "sA", ",", "p1", ",", "xB", ",", "e2A", ",", "e1A", ",", "eRA", ",", 
      "eRB", ",", "euB", ",", "e1B", ",", "BB0"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
