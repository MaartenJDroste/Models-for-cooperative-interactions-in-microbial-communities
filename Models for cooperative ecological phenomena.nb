Cell[CellGroupData[{

Cell["\<\
Optimisation problem: Maximise the growth rate of the producer for varying \
biomass yield of the consumer\
\>", "Subsubsection",
 CellChangeTimes->{{3.929695144133555*^9, 3.929695157197448*^9}, {
  3.929695260757389*^9, 3.929695261214814*^9}, {4.000551141546482*^9, 
