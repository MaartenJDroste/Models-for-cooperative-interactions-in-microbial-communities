bd307772f67c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ModelEquationsJoinedMixStrat", "[", "Kminv_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       FractionBox["vRA", "eTotA"], "]"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Positivity", " ", "constraints"}], "*)"}], 
      RowBox[{
       RowBox[{"sA", ">=", "0"}], ",", 
       RowBox[{"p1", ">=", "0"}], ",", 
       RowBox[{"xB", ">=", "0"}], ",", 
       RowBox[{"e2A", ">=", "0"}], ",", 
       RowBox[{"e1A", ">=", "0"}], ",", 
       RowBox[{"eRA", ">=", "0"}], ",", 
       RowBox[{"euB", ">=", "0"}], ",", 
       RowBox[{"e1B", ">=", "0"}], ",", 
       RowBox[{"eRB", ">=", "0"}], ",", 
       RowBox[{"BB0", ">=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Enzyme", " ", "constraints"}], "*)"}], 
       RowBox[{
        RowBox[{"eTA", "+", "e2A", "+", "e1A", "+", "eRA"}], "<=", "eTotA"}], 
       ",", 
       RowBox[{
        RowBox[{"euB", "+", "e1B", "+", "eRB"}], "<=", "eTotB"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Steady", " ", "states"}], "*)"}], 
       RowBox[{"vTA", "==", 
        RowBox[{"v2A", "+", "v1A", "+", 
         RowBox[{"YsARA", " ", "vRA"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRA", " ", "vRA"}], "==", " ", 
        RowBox[{
         RowBox[{"m2A", " ", "v2A"}], "+", 
         RowBox[{"m1A", " ", "v1A"}]}]}], ",", 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", "v1A"}], "==", 
        RowBox[{"BB0", " ", "vuBKm"}]}], ",", 
       RowBox[{
        RowBox[{"YxBp1", " ", "vuBKm"}], "==", 
        RowBox[{"v1B", "+", 
         RowBox[{"YxBRB", " ", "vRB"}]}]}], ",", 
       RowBox[{
        RowBox[{"mRB", " ", "vRB"}], "==", 
        RowBox[{"m1B", " ", "v1B"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Biomass", " ", "relation"}], "*)"}], 
       RowBox[{
        RowBox[{"BA0", " ", "Yp1sA", " ", 
         FractionBox["v1A", "vRA"]}], " ", "==", 
        RowBox[{
         FractionBox["BB0", "YxBp1"], 
         FractionBox["eTotB", "eTotA"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["mRB", "m1B"], "+", "YxBRB"}], ")"}]}]}]}], "}"}]}], 
    "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"Km", "->", "Kminv"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemFuncMixStrat", "[", 
   RowBox[{"Kminv_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ModelEquationsJoinedMixStrat", "[", "Kminv", "]"}], "/.", 
     "ParamsMixStrat"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "sA", ",", "p1", ",", "xB", ",", "e1A", ",", "e2A", ",", "eRA", ",", 
      "eRB", ",", "euB", ",", "e1B", ",", "BB0"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.971259726045789*^9, 3.9712597363488407`*^9}, {
