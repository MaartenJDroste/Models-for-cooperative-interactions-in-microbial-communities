Cell[TextData[{
 "We run the optimisation problem for different values of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "59077d64-07b6-4af5-9fa2-fb76d1b03fd8"],
 " concentration. After obtaining the results, we normalise the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "419d06d3-1856-454e-bb6e-136a8daf2ed0"],
 " concentration and the growth rate relative to the population containing \
only the producer."
}], "Text",
