Cell[CellGroupData[{

Cell[TextData[{
 "Optimisation problem: Maximise the growth rate of the producer for varying \
concentrations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2809437-f796-4925-9344-c5386a333c10"]
}], "Subsubsection",
 CellChangeTimes->{{3.929695144133555*^9, 3.929695157197448*^9}, {
  3.929695260757389*^9, 3.929695261214814*^9}, {4.000551141546482*^9, 
  4.000551142228889*^9}, {4.0005511743415937`*^9, 4.000551200299768*^9}, {
  4.000551287616398*^9, 
  4.0005513021060877`*^9}},ExpressionUUID->"8d39da3e-4ffa-418b-9b9f-\
7a5c93a4d8e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ModelEquationsJoinedFacSynRed", "[", "P1v_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Evaluate", "[", 
       FractionBox["vR", "eTot"], "]"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Positivity", " ", "constraints"}], "*)"}], 
      RowBox[{
       RowBox[{"sA", ">=", "0"}], ",", 
       RowBox[{"e2", ">=", "0"}], ",", 
       RowBox[{"e1", ">=", "0"}], ",", 
       RowBox[{"eR", ">=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Enzyme", " ", "constraints"}], "*)"}], 
       RowBox[{
        RowBox[{"eT", "+", "e2", "+", "e1", "+", "eR"}], "<=", "eTot"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Steady", " ", "states"}], "*)"}], 
       RowBox[{"vT", "==", 
        RowBox[{"v1", "+", "v2", "+", 
         RowBox[{"YsaR", " ", "vR"}]}]}], ",", 
       RowBox[{
        RowBox[{"mR", " ", "vR"}], "==", 
        RowBox[{
         RowBox[{"m2", " ", "v2"}], " ", "+", " ", 
         RowBox[{"m1", " ", "v1"}]}]}]}], "}"}]}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"p1", "->", "P1v"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimisationProblemFuncFacSynRed", "[", "P1v_", "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ModelEquationsJoinedFacSynRed", "[", "P1v", "]"}], "/.", 
